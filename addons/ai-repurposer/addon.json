{
    "name": "AI Content Repurposer",
    "slug": "ai-repurposer",
    "version": "1.0.0",
    "description": "Turn any YouTube video or uploaded audio/video into blog posts, X threads, LinkedIn articles, newsletters, TikTok scripts, show notes, key quotes, and chapter markers — all at once.",
    "author": "MakeAI",
    "min_makeai_version": "1.0.0",
    "envato_item_id": null,
    "requires_license": 1,
    "requires_pro": false,
    "admin_menu": [
        {
            "parent": "Content",
            "label": "Overview",
            "route": "addon.rp.admin.overview",
            "route_params": {},
            "route_pattern": "addon.rp.admin.overview",
            "icon": "ti ti-refresh",
            "permission": "addon.rp.manage"
        },
        {
            "parent": "Settings",
            "label": "Settings",
            "route": "addon.rp.admin.settings",
            "route_params": {},
            "route_pattern": "addon.rp.admin.settings",
            "icon": "ti ti-settings",
            "permission": "addon.rp.settings"
        }
    ],
    "settings": [
        { "key": "enabled",                   "type": "boolean",  "label": "Enable Content Repurposer",        "default": true,             "group": "general" },
        { "key": "ai_model",                  "type": "string",   "label": "AI model",                        "default": null,             "group": "ai" },
        { "key": "transcription_provider",    "type": "select",   "label": "Transcription provider",          "options": ["whisper","assemblyai"], "default": "whisper", "group": "ai" },
        { "key": "credits_per_repurpose",     "type": "integer",  "label": "Credits per single repurpose",    "default": 15,               "group": "credits" },
        { "key": "credits_per_bulk_item",     "type": "integer",  "label": "Credits per bulk item",           "default": 12,               "group": "credits" },
        { "key": "max_file_size_mb",          "type": "integer",  "label": "Max upload file size (MB)",       "default": 100,              "group": "limits" },
        { "key": "max_bulk_items",            "type": "integer",  "label": "Max URLs in bulk batch",          "default": 10,               "group": "limits" },
        { "key": "default_formats",           "type": "string",   "label": "Default formats (comma-separated)","default": "blog_post,twitter_thread,linkedin_article,email_newsletter", "group": "general" },
        { "key": "twitter_thread_length",     "type": "integer",  "label": "Max tweets in a thread",          "default": 10,               "group": "limits" },
        { "key": "blog_post_min_words",       "type": "integer",  "label": "Blog post min word count",        "default": 800,              "group": "limits" },
        { "key": "auto_save_blog",            "type": "boolean",  "label": "Auto-save blog post to core blog","default": false,             "group": "general" }
    ],
    "permissions": [
        { "slug": "addon.rp.use",      "name": "Use Content Repurposer",             "group": "Repurposer" },
        { "slug": "addon.rp.manage",   "name": "View Content Repurposer Overview",   "group": "Repurposer" },
        { "slug": "addon.rp.settings", "name": "Manage Content Repurposer Settings", "group": "Repurposer" }
    ],
    "hooks": []
}
