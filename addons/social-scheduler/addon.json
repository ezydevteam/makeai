{
    "slug": "social-scheduler",
    "name": "Social Scheduler Pro",
    "version": "1.0.0",
    "description": "Full social media scheduling suite with AI captions, drag-drop calendar, carousels, RSS auto-post, and approval workflows.",
    "author": "MakeAI",
    "min_makeai_version": "1.0.0",
    "envato_item_id": null,
    "requires_license": 1,
    "requires_pro": false,
    "admin_menu": [
        {
            "label": "Overview",
            "route": "addon.social.admin.overview",
            "route_params": {},
            "route_pattern": "addon.social.admin.overview",
            "icon": "ti ti-calendar-share",
            "permission": "addon.social.manage"
        },
        {
            "label": "Approval",
            "route": "addon.social.admin.approval.index",
            "route_params": {},
            "route_pattern": "addon.social.admin.approval.*",
            "icon": "ti ti-clipboard-check",
            "permission": "addon.social.approve"
        },
        {
            "label": "Settings",
            "route": "addon.social.admin.settings",
            "route_params": {},
            "route_pattern": "addon.social.admin.settings",
            "icon": "ti ti-settings",
            "permission": "addon.social.settings"
        }
    ],
    "settings": [
        { "key": "enabled",                    "type": "boolean",  "label": "Enable Social Scheduler",            "default": true,             "group": "general" },
        { "key": "approval_required",          "type": "boolean",  "label": "Require approval before publishing", "default": false,            "group": "general" },
        { "key": "max_accounts_per_user",      "type": "integer",  "label": "Max connected accounts per user",    "default": 10,               "group": "general" },
        { "key": "max_media_mb",               "type": "integer",  "label": "Max media upload size (MB)",         "default": 50,               "group": "general" },
        { "key": "ai_model",                   "type": "string",   "label": "AI model for captions",             "default": null,             "group": "ai" },
        { "key": "best_time_model",            "type": "string",   "label": "AI model for best-time analysis",   "default": null,             "group": "ai" },
        { "key": "rss_poll_interval_minutes",  "type": "integer",  "label": "RSS poll interval (minutes)",        "default": 60,               "group": "rss" },
        { "key": "analytics_pull_enabled",     "type": "boolean",  "label": "Pull post analytics daily",          "default": true,             "group": "analytics" },
        { "key": "carousel_max_slides",        "type": "integer",  "label": "Max carousel slides",                "default": 10,               "group": "general" },
        { "key": "first_comment_enabled",      "type": "boolean",  "label": "Enable first-comment scheduler (Instagram)", "default": true,      "group": "general" },
        { "key": "provider",                   "type": "string",   "label": "AI Provider",                        "default": null,             "group": "ai" },
        { "key": "custom_api_key",             "type": "encrypted","label": "Custom API Key (optional)",           "default": null,             "group": "ai", "secret": true }
    ],
    "permissions": [
        { "slug": "addon.social.manage",   "name": "Use Social Scheduler",              "group": "Social Scheduler" },
        { "slug": "addon.social.approve",  "name": "Approve Scheduled Posts",           "group": "Social Scheduler" },
        { "slug": "addon.social.settings", "name": "Manage Social Scheduler Settings",   "group": "Social Scheduler" }
    ],
    "hooks": []
}
