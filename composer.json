{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "inertiajs/inertia-laravel": "^3.1",
        "laravel/ai": "^0.7.2",
        "laravel/cashier": "^16.5",
        "laravel/cashier-paddle": "^2.8",
        "laravel/framework": "^13.7",
        "laravel/horizon": "^5.46",
        "laravel/reverb": "^1.10",
        "laravel/sanctum": "^4.3",
        "laravel/socialite": "^5.27",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.25.1",
        "maatwebsite/excel": "^3.1",
        "mpdf/mpdf": "^8.3",
        "predis/predis": "^3.4",
        "smalot/pdfparser": "^2.12",
        "tightenco/ziggy": "^2.6"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Addons\\AiAssistant\\": "addons/ai-assistant/app/",
            "Addons\\AiChatbot\\": "addons/ai-chatbot/app/",
            "Addons\\AiChatbot\\Database\\Seeders\\": "addons/ai-chatbot/database/seeders/",
            "Addons\\PublicKnowledgeBase\\": "addons/public-knowledge-base/app/",
            "Addons\\SocialScheduler\\": "addons/social-scheduler/app/",
            "Addons\\SocialScheduler\\Database\\Factories\\": "addons/social-scheduler/database/factories/",
            "Addons\\SocialScheduler\\Database\\Seeders\\": "addons/social-scheduler/database/seeders/",
            "Addons\\AiVideoCreator\\": "addons/ai-video-creator/app/",
            "Addons\\AiImageEditor\\": "addons/ai-image-editor/app/",
            "Addons\\AiImageEditor\\Database\\Seeders\\": "addons/ai-image-editor/database/seeders/",
            "Addons\\AiVideoCreator\\Database\\Seeders\\": "addons/ai-video-creator/database/seeders/",
            "Addons\\AiVoiceover\\": "addons/ai-voiceover/app/",
            "Addons\\AiVoiceover\\Database\\Seeders\\": "addons/ai-voiceover/database/seeders/",
            "Addons\\AiRepurposer\\": "addons/ai-repurposer/app/",
            "Addons\\AiRepurposer\\Database\\Seeders\\": "addons/ai-repurposer/database/seeders/",
            "Addons\\AiImagePro\\": "addons/ai-image-pro/app/",
            "Addons\\AiImagePro\\Database\\Seeders\\": "addons/ai-image-pro/database/seeders/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Resources\\Themes\\Default\\": "resources/themes/default/"
        },
        "files": [
            "app/Helpers/helpers.php",
            "app/Helpers/license.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#34d399,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --queue=otp,emails,mail,default,webhooks,ai,media,embeddings,social,low --tries=1 --timeout=0\" \"php artisan reverb:start --host=0.0.0.0 --port=8080\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,reverb,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "ext-pcntl": "8.3",
            "ext-posix": "8.3"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
