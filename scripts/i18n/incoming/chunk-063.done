        "Left to Right": "De izquierda a derecha",
        "Top Left to Bottom Right": "De arriba a la izquierda a abajo a la derecha",
        "Top Right to Bottom Left": "De arriba a la derecha a abajo a la izquierda",
        "Aurora Glow": "Resplandor Aurora",
        "Sunset Pop": "Pop Atardecer",
        "Royal Pulse": "Pulso Real",
