APP_NAME=MakeAI
APP_ENV=production
APP_KEY=
# MUST stay false on any public site. With debug on, an uncaught exception renders
# a stack trace containing your database credentials and API keys — including
# during installation, before the wizard has finished hardening this file.
# For local development set APP_ENV=local and APP_DEBUG=true.
APP_DEBUG=false
APP_URL=https://example.com
INSTALLED=false

# ─── Demo Mode (seller's public demo site only — NOT for real installations) ───
#
# DANGER: with DEMO_ENABLED=true the scheduler runs `demo:reset --force` every six
# hours, which runs `migrate:fresh` and DESTROYS ALL DATA in the database. It
# also publishes the demo login credentials on the sign-in page and disables
# license verification. Never enable it on a site with real data.
#
# Left commented out deliberately: every key below already has this exact default
# in config/demo.php, so uncommenting changes nothing unless you also flip
# DEMO_ENABLED to true — which then has to be a deliberate act, not a typo.
#
# DEMO_ENABLED=false
# DEMO_BANNER_COLOR=amber
# DEMO_ENVATO_URL=https://codecanyon.net
# DEMO_ADMIN_EMAIL=admin@demo.com
# DEMO_ADMIN_PASSWORD=demo12345
# DEMO_USER_EMAIL=demo@demo.com
# DEMO_USER_PASSWORD=demo12345
#
# ── Demo API credentials ──────────────────────────────────────────────────────
# migrate:fresh drops these from the database every six hours, so they live here
# and DemoProvisionSeeder writes them back at the end of each reset. Blank = not
# provisioned, so leaving any of them empty is safe.
#
# APP_KEY must never change on the demo host: these are encrypted at rest with it,
# and a rotated key silently turns every reseeded credential into garbage.
#
# The public spends these keys — use separate provider projects with hard spend caps
# and models you are happy to give away. Each model below is only applied when its
# own provider has a key here, so the fallback needs DEMO_AI_KEY_GOOGLE: the seeded
# Gemini Flash Lite is a native Google model, not an OpenRouter-routed one. Leave the
# Google key blank and the default still works; only the fallback stays unset.
# DEMO_AI_KEY_OPENROUTER=
# DEMO_AI_KEY_GOOGLE=
# DEMO_AI_DEFAULT_MODEL=deepseek/deepseek-v4-flash
# DEMO_AI_FALLBACK_MODEL=gemini-3.1-flash-lite
#
# Sandbox credentials only — the seeder forces every gateway into test mode. Each
# gateway needs ALL of its keys before it is enabled, so fill a gateway completely
# or leave it blank; a half-filled one is skipped rather than half-enabled.
# DEMO_STRIPE_PUBLISHABLE_KEY=
# DEMO_STRIPE_SECRET_KEY=
# DEMO_STRIPE_WEBHOOK_SECRET=
# DEMO_PAYPAL_CLIENT_ID=
# DEMO_PAYPAL_CLIENT_SECRET=
# DEMO_PAYPAL_WEBHOOK_ID=
# DEMO_PADDLE_API_KEY=
# DEMO_PADDLE_CLIENT_TOKEN=
# DEMO_PADDLE_WEBHOOK_SECRET=
# DEMO_RAZORPAY_KEY_ID=
# DEMO_RAZORPAY_KEY_SECRET=
# DEMO_RAZORPAY_WEBHOOK_SECRET=
# DEMO_SSLCOMMERZ_STORE_ID=
# DEMO_SSLCOMMERZ_STORE_PASSWORD=
# DEMO_COINGATE_AUTH_TOKEN=
# DEMO_COINGATE_WEBHOOK_TOKEN=
# DEMO_PAYSTACK_PUBLIC_KEY=
# DEMO_PAYSTACK_SECRET_KEY=
# DEMO_2CHECKOUT_MERCHANT_CODE=
# DEMO_2CHECKOUT_SECRET_KEY=
#
# Bank transfer needs no third-party account — just the instructions the buyer sees.
# Setting this alone gives the demo one complete, working checkout path.
# DEMO_BANK_TRANSFER_INSTRUCTIONS="Demo only — no real transfer required."
#
# OAuth apps. Redirect URIs are registered at the provider and survive resets, so
# only the id/secret pair belongs here.
# DEMO_OAUTH_GOOGLE_CLIENT_ID=
# DEMO_OAUTH_GOOGLE_CLIENT_SECRET=
# DEMO_OAUTH_TWITTER_CLIENT_ID=
# DEMO_OAUTH_TWITTER_CLIENT_SECRET=
#
# Settings → Extensions. Fill in ONE provider per integration — whichever account you
# have — and that provider is selected and switched on automatically. Half-filled
# providers are skipped, so there is no need to comment the others out.
# DEMO_EXT_COPYSCAPE_API_KEY=
# DEMO_EXT_COPYSCAPE_USERNAME=
# DEMO_EXT_ORIGINALITY_API_KEY=
# DEMO_EXT_GPTZERO_API_KEY=
# DEMO_EXT_SAPLING_API_KEY=
# DEMO_EXT_LANGUAGETOOL_API_KEY=
# DEMO_EXT_LANGUAGETOOL_BASE_URL=
# DEMO_EXT_DEEPL_AUTH_KEY=
# DEMO_EXT_GOOGLE_TRANSLATE_API_KEY=
# DEMO_EXT_AKISMET_API_KEY=
# DEMO_EXT_AKISMET_SITE_URL=
# DEMO_EXT_IPINFO_TOKEN=
# DEMO_EXT_EXCHANGERATE_API_KEY=
# DEMO_EXT_FIXER_API_KEY=
# DEMO_EXT_OPENAI_MODERATION_API_KEY=
# DEMO_EXT_SIGHTENGINE_API_USER=
# DEMO_EXT_SIGHTENGINE_API_SECRET=
# DEMO_EXT_ZEROBOUNCE_API_KEY=
# DEMO_EXT_NEVERBOUNCE_API_KEY=
#
# The SMS gateway also unlocks phone verification and SMS two-factor on the demo.
# DEMO_EXT_TWILIO_ACCOUNT_SID=
# DEMO_EXT_TWILIO_AUTH_TOKEN=
# DEMO_EXT_TWILIO_FROM=
# DEMO_EXT_VONAGE_API_KEY=
# DEMO_EXT_VONAGE_API_SECRET=
# DEMO_EXT_VONAGE_FROM=
# DEMO_EXT_MESSAGEBIRD_ACCESS_KEY=
# DEMO_EXT_MESSAGEBIRD_ORIGINATOR=
#
# Analytics providers carry no secret — an id/domain alone configures them, and the
# tracking script then loads for every demo visitor.
# DEMO_EXT_GA4_MEASUREMENT_ID=
# DEMO_EXT_GTM_CONTAINER_ID=
# DEMO_EXT_PLAUSIBLE_DOMAIN=
# DEMO_EXT_PLAUSIBLE_SCRIPT_URL=
# DEMO_EXT_UMAMI_WEBSITE_ID=
# DEMO_EXT_UMAMI_SCRIPT_URL=
#
# reCAPTCHA. The keys are provisioned whenever both are set, but the guard stays
# OFF until you flip DEMO_RECAPTCHA_ENABLED — captcha sits in front of sign-in, so
# a site key that does not list the demo domain locks everyone out until the next
# reset. Provision first, confirm the challenge renders, then switch it on.
# DEMO_RECAPTCHA_ENABLED=false
# DEMO_RECAPTCHA_SITE_KEY=
# DEMO_RECAPTCHA_SECRET_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# 'daily' rotates and prunes to LOG_DAILY_DAYS; 'single' grows one file without
# limit, which eventually fills a shared-hosting disk quota.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# 'debug' writes every query and payload to disk — noisy, and it can persist
# personal data. Use 'debug' only while diagnosing a problem.
LOG_LEVEL=error

# MySQL 8.0+ / MariaDB 10.4+ required. The install wizard fills these in for you;
# set them by hand only for a manual or CLI deployment.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie security. In production over HTTPS set SESSION_SECURE_COOKIE=true so the
# session cookie is never sent over plaintext HTTP. Leave as null for local http
# development (null = Secure flag auto-enabled only on HTTPS requests). The web
# installer sets this to true automatically for production installs.
SESSION_SECURE_COOKIE=null
SESSION_SAME_SITE=lax

# Realtime delivery is chosen in the admin panel (Settings → Notifications):
# Reverb, Pusher, or Polling. That setting is applied at runtime and OVERRIDES
# this value on every request, so changing it here has no effect — it is only the
# fallback used if the settings table cannot be read. Leave it as 'null'.
BROADCAST_CONNECTION=null

# ─── Storage ──────────────────────────────────────────────────────────────────
# Cloud storage (Amazon S3, Cloudflare R2, DigitalOcean Spaces, Wasabi, Backblaze B2)
# is NOT configured here. Choose the driver and enter the bucket credentials in the
# admin panel under Settings → Storage; they are stored encrypted in the database and
# can be tested and migrated from that screen. The AWS_* keys further down are used
# only by the optional SQS queue driver, not by media storage.
FILESYSTEM_DISK=local
# PUBLIC_DISK_ROOT=
# Left COMMENTED OUT on purpose. config/filesystems.php now treats an empty value as
# unset, but an uncommented empty key still reads as "someone configured this" to anyone
# editing the file by hand, and that is what produced installs whose media root resolved
# to the filesystem root.
# Note: PUBLIC_DISK_ROOT is auto-configured during installation for zero-config deployments.
# It points the public media disk at a directory inside the served webroot, so uploads
# work without a `storage:link` symlink (shared hosting often forbids symlinks).
# Leave it commented out or blank for local development.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── WebSocket credentials (Reverb / Pusher) ──────────────────────────────────
# Enter these in the admin panel under Settings → Notifications instead; they are
# stored in the database, take precedence over everything here, and apply without
# a redeploy. These env keys are only a fallback for scripted deployments, and
# are read ONLY when the matching database setting is empty — so a non-empty
# value here silently wins over the application defaults. Leave them blank
# unless you are deliberately provisioning from the environment.
#
# Reverb is a self-hosted WebSocket server: it needs `php artisan reverb:start`
# running under a process supervisor. It does NOT require Redis unless you run
# more than one Reverb node and need shared connection state.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=
REVERB_SCHEME=
# Bind address of the Reverb process itself (not read from the database).
# Put a TLS-terminating proxy in front of it — ws:// is plaintext.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS="${APP_URL}"

# Pusher is the hosted alternative to Reverb; set one or the other, not both.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

# Mail is configured in the admin panel (Settings → Email), stored encrypted in
# the database, and overrides everything here at runtime — these are only the
# fallback used before that is set up (or when MAIL_CONFIG_FROM_ENV=true below).
# 'log' writes messages to the log file instead of sending: fine pre-launch, but
# configure a real mailer in the admin panel before going live or password resets
# will never reach anyone.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Set true to ignore the admin-panel mail settings entirely and use the MAIL_*
# values above. Intended for local and staging: mail config lives in the database,
# so a restored production dump would otherwise point a dev box at live SMTP —
# and this app mails real users on register, password reset and email change.
# Leave false (or unset) in production.
MAIL_CONFIG_FROM_ENV=false

# These are for the optional SQS queue driver only (QUEUE_CONNECTION=sqs).
# They do NOT configure media storage — set your S3/R2/Spaces/Wasabi/B2 bucket in the
# admin panel under Settings → Storage instead. Leave blank unless you use SQS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Developer-only: enables fake purchase codes for pre-release testing.
# MUST remain false (or absent) in any real installation. Leave commented out.
# LICENSE_TEST_MODE=false
