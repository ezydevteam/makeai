# MakeAI — nginx configuration (VPS / dedicated server)
#
# nginx does NOT read .htaccess files. The Apache rules shipped with this
# package therefore do nothing here, and WITHOUT the "location /core" block
# below your database password, APP_KEY and API credentials are publicly
# readable at https://your-domain.com/core/.env
#
# Copy to /etc/nginx/sites-available/your-site, adjust server_name and root,
# then:  ln -s /etc/nginx/sites-available/your-site /etc/nginx/sites-enabled/
#        nginx -t && systemctl reload nginx
#
# For HTTPS, run certbot AFTER this is working (see the bottom of this file).
# It rewrites this block in place, adding the certificate paths and the
# HTTP -> HTTPS redirect for you.

server {
    listen 80;
    listen [::]:80;

    server_name your-domain.com www.your-domain.com;

    # Point at the folder containing index.php — NOT at core/
    root /var/www/your-site;
    index index.php;

    charset utf-8;
    server_tokens off;                 # don't advertise the nginx version

    # Uploads: documents for RAG, images, audio. Keep this >= the smaller of
    # PHP's upload_max_filesize and post_max_size, or large uploads fail with a
    # 413 before PHP ever sees them.
    client_max_body_size 64M;

    # ─── REQUIRED: keep the application directory private ───
    location ~ ^/core(/|$) {
        deny all;
        return 404;
    }

    # Deny dotfiles anywhere (.env, .env.backup, ...), except ACME challenges
    # so certbot's webroot mode keeps working.
    location ~ /\.(?!well-known) {
        deny all;
        return 404;
    }

    # Belt and braces: never serve these regardless of where they turn up.
    location ~* \.(env|log|sqlite)$ {
        deny all;
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # robots.txt ships as a real file; sitemap.xml is generated by the
    # application, so it falls through to index.php via the block above.
    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    # Fingerprinted build assets — safe to cache forever, Vite renames on change.
    location ^~ /build/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # Uploaded media and other static files.
    location ~* \.(jpg|jpeg|png|gif|ico|svg|webp|css|js|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    location ~ \.php$ {
        # Adjust to your PHP version's socket
        fastcgi_pass unix:/var/run/php/php8.3-fpm.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;

        # ─── Streaming (Server-Sent Events) ───
        # AI generations stream token-by-token over SSE. The application sends
        # `X-Accel-Buffering: no` per response, which nginx honours, so output
        # is not held back — but the READ TIMEOUT is what decides whether a long
        # generation survives. At nginx's 60s default a lengthy answer is cut
        # off mid-stream and the user sees a truncated result with no error.
        fastcgi_read_timeout 300;      # max seconds one generation may run
        fastcgi_request_buffering off; # start processing uploads immediately
        fastcgi_keep_conn on;

        # Behind a TLS-terminating proxy or load balancer, uncomment this so the
        # application knows the original request was secure and generates https
        # URLs. Do NOT set it while genuinely serving plain HTTP — every
        # generated link would point at a port that is not listening.
        # fastcgi_param HTTPS on;
    }

    # gzip for text assets. Images, fonts and build output are already
    # compressed, so they are deliberately absent from this list.
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

    error_page 404 /index.php;

    access_log /var/log/nginx/your-site-access.log;
    error_log  /var/log/nginx/your-site-error.log;
}

# ─── HTTPS ───
# Once the site loads over HTTP, run:
#
#   certbot --nginx -d your-domain.com -d www.your-domain.com
#
# certbot edits the block above: it adds `listen 443 ssl`, the certificate
# paths, and a second server block redirecting port 80 to HTTPS. Set APP_URL in
# core/.env to the https:// address afterwards, or generated links and OAuth
# callbacks will keep pointing at http://.
#
# On nginx 1.25.1+, prefer the modern directive over the deprecated
# `listen 443 ssl http2;` form:
#
#   http2 on;

# ─── OPTIONAL: Laravel Reverb (WebSockets) ───
# Only needed if you enable real-time broadcasting via Reverb in
# Admin -> Settings -> Notifications. Without it the application degrades to
# Pusher and then to HTTP polling, so the site works either way.
# Start the server with: php artisan reverb:start
#
# location /app/ {                       # Reverb's default path prefix
#     proxy_pass http://127.0.0.1:8080;
#     proxy_http_version 1.1;
#     proxy_set_header Upgrade $http_upgrade;
#     proxy_set_header Connection "Upgrade";
#     proxy_set_header Host $host;
#     proxy_read_timeout 60s;
# }
