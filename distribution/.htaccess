# Primary guard: deny the application directory outright. This block does NOT
# depend on mod_rewrite — if rewriting is unavailable the rules further down are
# skipped entirely, and core/.env must stay unreachable regardless.
RedirectMatch 404 ^/core(/|$)

# Deny dotfiles (.env, .env.backup, ...) anywhere in the tree.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Long-lived caching for fingerprinted build output.
#
# Everything under /build/assets carries a content hash in its filename (Vite),
# so a changed file is a NEW url and can never be served stale — the only safe
# place for `immutable`. Without this the host default applies, and cPanel/
# LiteSpeed commonly ship 4 hours, which makes Lighthouse's "use efficient cache
# lifetimes" fire and costs repeat visitors a full re-download of the bundle.
#
# Deliberately scoped to the hashed directory. Do NOT widen this to /storage:
# those filenames are stable across re-uploads, so an immutable year would pin
# a replaced logo in every visitor's cache.
<IfModule mod_headers.c>
    <IfModule mod_setenvif.c>
        SetEnvIf Request_URI "^/build/assets/" IMMUTABLE_ASSET=1
        Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE_ASSET
    </IfModule>
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Block all direct access to the Laravel application directory
    RewriteRule ^core/ - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
